{
  "name": "@cubearc/play-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "desktop:build": "node node_modules/electron/install.js && tsc -p tsconfig.desktop.json && vite build --config vite.desktop.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.main.config.ts && node desktop-dist/prepare.js",
    "desktop:proof": "electron desktop-dist/main.js",
    "desktop:test": "node --test --test-concurrency=1 desktop-dist/*.test.js",
    "desktop:smoke": "node --test desktop-dist/desktop.e2e.js",
    "build": "npm run desktop:build",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "node scripts/coverage.mjs",
    "test:e2e": "npm run desktop:smoke",
    "desktop:package": "node desktop-dist/package.js"
  },
  "dependencies": {
    "@vscode-elements/elements": "2.5.1",
    "@vscode-elements/react-elements": "2.4.0",
    "@vscode/codicons": "0.0.45",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "electron": "45.1.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "monocart-coverage-reports": "3.2.0",
    "vitest-monocart-coverage": "5.0.0"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "14.0.3",
      "minimatch": "11.0.3"
    }
  }
}
