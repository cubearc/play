{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "outDir": "desktop-dist",
    "rootDir": "desktop",
    "types": ["node"]
  },
  "include": ["desktop/**/*.ts", "desktop/**/*.cts"]
}
